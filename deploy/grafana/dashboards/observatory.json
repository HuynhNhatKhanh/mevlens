    {
      "id": 8,
      "title": "Arbitrages per interval",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(timestamp) AS time, status, count() AS n FROM mevlens.arbitrages_v WHERE $__timeFilter(timestamp) GROUP BY time, status ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Priority fee per gas (gwei), p50 / p90",
      "type": "timeseries",
      "description": "Under PGA the priority fee is the ordering bid.",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(timestamp) AS time, quantile(0.5)(priority_fee) / 1e9 AS p50, quantile(0.9)(priority_fee) / 1e9 AS p90 FROM mevlens.arbitrages_v WHERE $__timeFilter(timestamp) GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Top arbitrage contracts",
      "type": "table",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 14,
        "h": 10
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT contract, countIf(status = 'success') AS wins, countIf(status = 'reverted') AS reverts, round(sum(profit_eth), 6) AS gross_eth, round(sum(cost_eth), 6) AS gas_eth FROM mevlens.arbitrages_v WHERE $__timeFilter(timestamp) GROUP BY contract ORDER BY wins DESC LIMIT 20",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Hops distribution",
      "type": "barchart",
      "description": "",
      "gridPos": {
        "x": 14,
        "y": 13,
        "w": 10,
        "h": 10
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT toString(hops) AS hops, count() AS n FROM mevlens.arbitrages_v WHERE $__timeFilter(timestamp) AND status = 'success' GROUP BY hops ORDER BY hops",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
