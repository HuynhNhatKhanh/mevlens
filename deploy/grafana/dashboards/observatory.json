      "options": {}
    },
    {
      "id": 4,
      "title": "Revert share",
      "type": "stat",
      "description": "Baseline under Timeboost was ~20% (arXiv 2509.22143).",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT countIf(status = 'reverted') / count() FROM mevlens.arbitrages_v WHERE $__timeFilter(timestamp)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Median net profit (ETH)",
      "type": "stat",
      "description": "Gross profit minus gas, for arbitrages whose profit token is WETH or a USD stablecoin.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT quantile(0.5)(net_eth) FROM mevlens.arbitrages_v WHERE $__timeFilter(timestamp) AND status = 'success' AND profit_eth IS NOT NULL",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
