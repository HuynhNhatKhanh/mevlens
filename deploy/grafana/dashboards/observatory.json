    {
      "id": 2,
      "title": "Successful arbitrages",
      "type": "stat",
      "description": "Atomic arbitrages on canonical v2/v3 pools in the selected range.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT count() FROM mevlens.arbitrages_v WHERE $__timeFilter(timestamp) AND status = 'success'",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Reverted attempts",
      "type": "stat",
      "description": "Reverted transactions sent to contracts previously seen arbitraging: lost races still pay gas.",
